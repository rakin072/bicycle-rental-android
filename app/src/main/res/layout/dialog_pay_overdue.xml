<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/surface_dark">

    <!-- Dialog Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="💳 Pay Overdue Charges"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <!-- Bicycle Model -->
    <TextView
        android:id="@+id/bicycleModelText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Bicycle: Mountain Bike X1"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:layout_marginBottom="8dp" />

    <!-- Days Late -->
    <TextView
        android:id="@+id/daysLateText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Days Late: 3"
        android:textColor="@color/error"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <!-- Amount -->
    <TextView
        android:id="@+id/amountText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Amount: 150.0 Taka"
        android:textColor="@color/error"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/text_secondary"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp" />

    <!-- Transaction ID Input -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Transaction ID"
        app:boxBackgroundMode="outline"
        app:boxStrokeColor="@color/login_button_green"
        android:textColorHint="@color/text_secondary"
        android:layout_marginBottom="12dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/transactionIdInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:textColor="@color/text_primary"
            android:maxLines="1" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Payment Details Input -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Payment Details (optional)"
        app:boxBackgroundMode="outline"
        app:boxStrokeColor="@color/login_button_green"
        android:textColorHint="@color/text_secondary"
        android:layout_marginBottom="8dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/detailsInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textMultiLine"
            android:textColor="@color/text_primary"
            android:lines="3"
            android:gravity="top|start" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Helper Text -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="💡 Pay outside the app and enter transaction ID"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:textStyle="italic"
        android:layout_marginBottom="24dp" />

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/cancelButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancel"
            android:textColor="@color/text_secondary"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_marginEnd="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/confirmButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Submit Payment"
            android:textColor="@android:color/white"
            app:backgroundTint="@color/login_button_green"
            app:cornerRadius="8dp" />

    </LinearLayout>

</LinearLayout>
